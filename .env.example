VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
GOOGLE_CLOUD_API_KEY=

# Server-side login (POST /api/login). The PIN is verified here against a scrypt
# hash using firebase-admin. Provide credentials ONE of these ways:
#   - GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#   - FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
#   - or rely on Application Default Credentials on GCP/Functions.
# firebase-admin is an optional dependency of the API deployment, not the client:
#   npm install firebase-admin --save-optional
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
