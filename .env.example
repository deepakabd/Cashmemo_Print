VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Cloudflare R2 (server-only; never prefix secrets with VITE_)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=cashmemo-sales-reports
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
GOOGLE_CLOUD_API_KEY=

# Server-side login (POST /api/login). The PIN is verified here against a scrypt
# hash using firebase-admin. Provide credentials ONE of these ways:
#   - GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#   - FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
#   - or rely on Application Default Credentials on GCP/Functions.
# firebase-admin is a required server dependency, not part of the client bundle.
# On Vercel, set FIREBASE_SERVICE_ACCOUNT to the complete service-account JSON
# in Production environment variables. A local Windows credentials path will
# not exist on Vercel. Redeploy after changing production environment variables.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
