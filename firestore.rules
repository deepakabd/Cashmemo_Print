rules_version = '2';

// ---------------------------------------------------------------------------
// Cashmemo Firestore Security Rules
//
// These rules are the ACTUAL security boundary. The React app's permission
// engine (src/app/permissions.js, getAdminTabAccess) only decides what the UI
// shows — anyone can bypass it from devtools.
//
// Auth model after the PIN migration:
//   * Users sign in with dealer code + PIN via POST /api/login. The server
//     verifies a scrypt hash and returns a Firebase custom token, which the
//     client exchanges for a real Auth session. So `request.auth` is populated
//     for both admins and dealers.
//   * The token carries custom claims: dealerCode, role, accountActive, planActive.
//   * Admins sign in with Firebase Auth email/password (adminSignIn).
//
// Admin identity is derived from the `role` custom claim, NOT from the client.
// Set it with:
//   admin.auth().setCustomUserClaims(uid, { role: 'admin' })
//
// DEPLOY:  firebase deploy --only firestore:rules
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Admins opt in via a custom claim set through the Admin SDK.
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Account/plan state comes from the verified token, so a client cannot
    // claim to be active by patching its own document.
    function isActiveAccount() {
      return isSignedIn() && request.auth.token.accountActive == true;
    }

    function hasActivePlan() {
      return isSignedIn() && request.auth.token.planActive == true;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The signed-in dealer's own document, matched by its dealerCode claim.
    function isOwnDealerDoc() {
      return isSignedIn()
        && request.auth.token.dealerCode != null
        && request.auth.token.dealerCode == resource.data.dealerCode;
    }

    // A user may only ever touch their own credential material in a document
    // they are otherwise allowed to write. Plaintext `pin` is rejected outright.
    function pinFieldsSafe() {
      return request.resource.data.get('pin', null) == null;
    }

    function singletonMatches(userId, field, group, item) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || getAfter(/databases/$(database)/documents/users/$(userId)/$(group)/$(item)).data.value
          == request.resource.data[field];
    }

    function configCopiesMatch(userId) {
      return singletonMatches(userId, 'profileData', 'profile', 'main')
        && singletonMatches(userId, 'bankDetailsData', 'bank', 'details')
        && singletonMatches(userId, 'cashMemoLabelSettings', 'settings', 'cashmemo')
        && singletonMatches(userId, 'ratesData', 'rates', 'current')
        && singletonMatches(userId, 'hindiHeaderData', 'header', 'current')
        && singletonMatches(userId, 'deliveryAreaUpdates', 'deliveryArea', 'updates')
        && singletonMatches(userId, 'deliveryStaffUpdates', 'deliveryStaff', 'updates');
    }

    // ---- users -------------------------------------------------------------

    match /users/{userId} {

      // A dealer may read only their own profile. Admins read all.
      // Anonymous reads are denied: this collection used to hold plaintext PINs
      // and must never be enumerable from the public registration form again.
      allow read: if isAdmin() || isSelf(userId) || isOwnDealerDoc();

      // Dealers cannot create their own user document; registration goes
      // through `registrationRequests` and is actioned by an admin.
      // Creation and dealer-code changes go through the trusted transaction
      // endpoint, which enforces uniqueness against legacy and new users.
      allow create: if false;
      allow delete: if false;

      // Admin mutations use the authenticated server endpoint. Direct writes
      // remain available only for a dealer's permitted self-service fields.
      allow update: if !isAdmin() && configCopiesMatch(userId) && (
          (isSelf(userId) || isOwnDealerDoc())
          && isActiveAccount()
          && pinFieldsSafe()
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['dealerCode', 'role', 'status', 'package', 'packageDays', 'validFrom', 'validTill', 'pinHash', 'pin', 'authUid', 'approvalStatus'])
        );

      match /{group}/{item} {
        function configField() {
          return group == 'profile' && item == 'main' ? 'profileData'
            : group == 'bank' && item == 'details' ? 'bankDetailsData'
            : group == 'settings' && item == 'cashmemo' ? 'cashMemoLabelSettings'
            : group == 'rates' && item == 'current' ? 'ratesData'
            : group == 'header' && item == 'current' ? 'hindiHeaderData'
            : group == 'deliveryArea' && item == 'updates' ? 'deliveryAreaUpdates'
            : group == 'deliveryStaff' && item == 'updates' ? 'deliveryStaffUpdates' : '';
        }
        function ownsParent() {
          return isSignedIn() && (isSelf(userId)
            || request.auth.token.dealerCode == get(/databases/$(database)/documents/users/$(userId)).data.dealerCode);
        }
        allow read: if configField() != '' && (isAdmin() || ownsParent());
        allow create, update: if configField() != ''
          && !isAdmin() && ownsParent() && isActiveAccount()
          && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
          && request.resource.data.value
            == getAfter(/databases/$(database)/documents/users/$(userId)).data[configField()];
      }
      match /invoices/{invoiceId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.token.dealerCode == get(/databases/$(database)/documents/users/$(userId)).data.dealerCode);
        allow write: if false;
      }
      match /consumers/{consumerId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.token.dealerCode == get(/databases/$(database)/documents/users/$(userId)).data.dealerCode);
        allow write: if false;
      }
      match /billingCounters/{year} { allow read, write: if false; }
      match /billingAdjustments/{entryId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.token.dealerCode == get(/databases/$(database)/documents/users/$(userId)).data.dealerCode);
        allow write: if false;
      }
    }

    // ---- registration requests --------------------------------------------

    // Created by an unauthenticated visitor during sign-up, then actioned by an
    // admin. Reads are admin-only so pending applications (which include contact
    // details) are not publicly listable.
    match /registrationRequests/{requestId} {
      function safeRegistrationCredentials() {
        let hash = request.resource.data.get('pinHash', null);
        return pinFieldsSafe()
          && request.resource.data.get('confirmPin', null) == null
          && (hash == null || (hash is string
            && hash.matches('scrypt[$]16384[$]8[$]1[$][A-Za-z0-9+/]{22}==[$][A-Za-z0-9+/]{86}==')));
      }
      allow create: if safeRegistrationCredentials();
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && safeRegistrationCredentials();
    }

    // ---- update approvals --------------------------------------------------

    match /updateApprovals/{approvalId} {
      allow read: if isAdmin() || (isSignedIn() && isActiveAccount());
      allow create: if isSignedIn() && isActiveAccount() && hasActivePlan()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (
        isSignedIn() && isActiveAccount() && hasActivePlan()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.type == resource.data.type
        && resource.data.status == 'pending'
        && request.resource.data.status == 'pending'
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['userId', 'type', 'status', 'requestedAt'])
      );
      allow delete: if isAdmin();
    }

    // ---- shared dictionary / settings --------------------------------------

    // Translation dictionary is used by all signed-in clients; only admins and
    // the dictionary approval flow may write to it.
    match /translationDictionary/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- admin-only collections -------------------------------------------

    match /adminAuditTrail/{docId} {
      allow read, write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- default deny ------------------------------------------------------

    // Anything not explicitly matched above is denied. This is intentional:
    // adding a new collection requires an explicit rule decision.
  }
}
